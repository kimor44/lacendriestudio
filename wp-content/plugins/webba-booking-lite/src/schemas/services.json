            "title": "Deposit amount",
            "tab": "pricing",
            "misc": {
                "tooltip": "The part of the service price that must be paid online in advance.",
                "sub_type": "none_negative_float",
                "dependent_value": {
                    "condition": [
                        "enable_deposit",
                        "!=",
                        "yes"
                    ],
                    "value": "0"
                },
                "hide": [
                    [
                        "enable_deposit",
                        "=",
                        "yes"
                    ]
                ],
