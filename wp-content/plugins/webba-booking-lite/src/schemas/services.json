        "service_group_booking": {
            "type": "string",
            "input_type": "checkbox",
            "hidden": true,
            "title": "Enable group booking",
            "tab": "general",
            "misc": {
                "yes": "Oui",
                "tooltip": "Si vous acceptez les r\u00e9servations de groupe, vous pouvez sp\u00e9cifier le nombre minimum de r\u00e9servations requises par tranche horaire.",
                "description": "If you accept group reservations, you can specify the minimum number of bookings required per time slot and set the maximum number of bookings allowed per time slot by enabling the option above.",
                "required_plan": "standard",
                "available_in_old_free": true
            },
            "required": false,
            "dependency": [],
            "default_value": "",
            "editable": true
        },
        "service_min_quantity": {
            "type": "string",
            "input_type": "text",
            "hidden": true,
            "title": "Nombre minimum de r\u00e9servations par tranche horaire",
            "tab": "general",
            "misc": {
                "tooltip": "Si vous acceptez les r\u00e9servations de groupe, vous pouvez sp\u00e9cifier le nombre minimum de r\u00e9servations requises par tranche horaire.",
                "sub_type": "positive_integer",
                "dependent_value": {
                    "condition": [
                        "group_booking",
                        "!=",
                        "yes"
                    ],
                    "value": "1"
                },
                "hide": [
                    [
                        "group_booking",
                        "=",
                        "yes"
                    ]
                ]
            },
            "required": true,
            "dependency": [],
            "default_value": "1",
            "editable": true
