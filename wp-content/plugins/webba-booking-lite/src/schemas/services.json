            "hidden": true,
            "title": "Enable deposit",
            "tab": "pricing",
            "misc": {
                "yes": "Oui",
                "tooltip": "Allow customers to pay only a part of the total price online as a deposit.",
                "description": "When enabled, customers will be charged the deposit amount instead of the full service price during online payment.",
