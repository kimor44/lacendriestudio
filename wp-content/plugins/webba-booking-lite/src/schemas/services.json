                "dependent_value": {
                    "condition": [
                        "group_booking",
                        "!=",
                        "yes"
                    ],
                    "value": "1"
                },
                "hide": [
                    [
                        "group_booking",
                        "=",
                        "yes"
                    ]
                ]
            },
            "required": true,
            "dependency": [],
            "default_value": "1",
            "editable": true
